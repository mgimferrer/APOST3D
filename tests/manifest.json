{
  "tests": [
    {
      "name": "H2O-T-B3LYP",
      "description": "Water molecule, RKS B3LYP / aug-cc-pVTZ — TFVC populations, ENPART (DFT), local spin",
      "tags": ["dft", "enpart", "spin", "tfvc", "rks"],
      "timeout": 600,
      "extra_input_files": [],
      "keywords": [
        "TFVC",
        "SPIN",
        "ENPART", "ENPART/B3LYP", "ENPART/THREBOD", "ENPART/MOD-GRIDTWOEL",
        "GRID/RADIAL", "GRID/ANGULAR", "GRID/PHB1", "GRID/PHB2"
      ],
      "checks": [
        {
          "label": "Normal Termination",
          "type": "present",
          "pattern": "Normal Termination"
        },
        {
          "label": "Total KS-DFT energy (au)",
          "pattern": "Total KS-DFT energy\\s*:\\s*([-+]?\\d+\\.\\d+)",
          "ref": -76.2241116,
          "tol_abs": 1e-4
        },
        {
          "label": "Integration error (au)",
          "pattern": "Integration error \\(au\\):\\s*([-+]?\\d+\\.\\d+)",
          "ref": -8e-07,
          "tol_abs": 1e-5
        },
        {
          "label": "O TFVC atomic charge",
          "section": "TOTAL ATOMIC CHARGES",
          "pattern": "1\\s+O\\s+([-+]?\\d+\\.\\d+)",
          "ref": -0.551876,
          "tol_abs": 1e-3
        },
        {
          "label": "H TFVC atomic charge",
          "section": "TOTAL ATOMIC CHARGES",
          "pattern": "2\\s+H\\s+([-+]?\\d+\\.\\d+)",
          "ref": 0.275938,
          "tol_abs": 1e-3
        },
        {
          "label": "O spin population",
          "section": "SPIN POPULATIONS",
          "pattern": "1\\s+O\\s+([-+]?\\d+\\.\\d+)",
          "ref": 1.235156,
          "tol_abs": 1e-3
        },
        {
          "label": "H spin population",
          "section": "SPIN POPULATIONS",
          "pattern": "2\\s+H\\s+([-+]?\\d+\\.\\d+)",
          "ref": 0.382422,
          "tol_abs": 1e-3
        },
        {
          "label": "O-H TFVC bond order",
          "section": "BOND ORDER MATRIX",
          "pattern": "1\\s+O\\s+\\S+\\s+([-+]?\\d+\\.\\d+)",
          "ref": 0.707736,
          "tol_abs": 1e-3
        },
        {
          "label": "O IQA self-energy (au)",
          "section": "FUZZY ATOMS KS-DFT ENERGY COMPONENTS",
          "pattern": "1\\s+O\\s+([-+]?\\d+\\.\\d+)",
          "ref": -75.021251,
          "tol_abs": 1e-3
        },
        {
          "label": "O-H IQA interaction (au)",
          "section": "FUZZY ATOMS KS-DFT ENERGY COMPONENTS",
          "pattern": "1\\s+O\\s+[-+]?\\d+\\.\\d+\\s+([-+]?\\d+\\.\\d+)",
          "ref": -0.237810,
          "tol_abs": 1e-3
        }
      ]
    },

    {
