        "GRID/RADIAL",
        "GRID/ANGULAR",
        "GRID/PHB1",
        "GRID/PHB2"
      ],
      "checks": [
        {
          "label": "Normal Termination",
          "type": "present",
          "pattern": "Normal Termination"
        },
        {
          "label": "Total KS-DFT energy (au)",
          "pattern": "Total KS-DFT energy\\s*:\\s*([-+]?\\d+\\.\\d+)",
          "ref": -76.2241116,
          "tol_abs": 2e-06
        },
        {
          "label": "Integration error (au)",
          "pattern": "Integration error \\(au\\):\\s*([-+]?\\d+\\.\\d+)",
          "ref": -8e-07,
          "tol_abs": 2e-06
        },
        {
          "label": "O TFVC atomic charge",
          "section": "TOTAL ATOMIC CHARGES",
          "pattern": "1\\s+O\\s+([-+]?\\d+\\.\\d+)",
          "ref": -0.551876,
          "tol_abs": 2e-05
        },
        {
          "label": "H TFVC atomic charge",
          "section": "TOTAL ATOMIC CHARGES",
          "pattern": "2\\s+H\\s+([-+]?\\d+\\.\\d+)",
