          "tol_abs": 1e-4
        },
        {
          "label": "Kinetic energy (au)",
          "pattern": "Kinetic energy:\\s*([-+]?\\d+\\.\\d+)",
          "ref": 79.2827782,
          "tol_abs": 1e-4
        },
        {
          "label": "KS-DFT electron-electron energy (au)",
          "pattern": "KS-DFT electron-electron energy:\\s*([-+]?\\d+\\.\\d+)",
          "ref": 67.2363766,
          "tol_abs": 1e-3
        }
      ]
    },

    {
      "name": "CH3F",
      "description": "Fluoromethane, RKS DFT — TFVC populations, fragment OSLO analysis",
      "tags": ["dft", "oslo", "tfvc", "rks", "fragments"],
      "timeout": 600,
      "extra_input_files": ["CH3F-OSLOs.fchk", "CH3F-OSLOs-preortho.fchk"],
      "keywords": [
        "TFVC",
        "OSLO", "OSLO/FOLI-TOLERANCE", "OSLO/BRANCH-ITERATION", "OSLO/PRINT-NON-ORTHO",
        "DOFRAGS"
      ],
      "checks": [
        {
          "label": "Normal Termination",
          "type": "present",
          "pattern": "Normal Termination"
        },
        {
          "label": "C TFVC electron population",
          "section": "ELECTRON POPULATIONS",
          "pattern": "1\\s+C\\s+([-+]?\\d+\\.\\d+)",
          "ref": 5.126631,
          "tol_abs": 1e-3
        },
        {
          "label": "F TFVC electron population",
          "section": "ELECTRON POPULATIONS",
          "pattern": "2\\s+F\\s+([-+]?\\d+\\.\\d+)",
          "ref": 9.721908,
          "tol_abs": 1e-3
        },
        {
          "label": "C TFVC atomic charge",
          "section": "TOTAL ATOMIC CHARGES",
          "pattern": "1\\s+C\\s+([-+]?\\d+\\.\\d+)",
          "ref": 0.873369,
          "tol_abs": 1e-3
        },
        {
          "label": "F TFVC atomic charge",
          "section": "TOTAL ATOMIC CHARGES",
          "pattern": "2\\s+F\\s+([-+]?\\d+\\.\\d+)",
          "ref": -0.721908,
          "tol_abs": 1e-3
        },
        {
          "label": "C-F bond order",
          "section": "BOND ORDER MATRIX",
          "pattern": "1\\s+C\\s+\\S+\\s+([-+]?\\d+\\.\\d+)",
          "ref": 0.812947,
          "tol_abs": 1e-3
        },
        {
          "label": "OSLO 1 FOLI value",
          "section": "Summary of the selected OSLOs \\(pre-ortho\\)",
          "pattern": "FOLI Value\\s+:\\s+([-+]?\\d+\\.\\d+)",
          "ref": 1.00002,
          "tol_abs": 1e-3
        },
        {
          "label": "OSLO 9 FOLI value (most delocalized)",
          "section": "Summary of the selected OSLOs \\(pre-ortho\\)",
          "pattern": "1\\.06204\\s+([-+]?\\d+\\.\\d+)",
          "ref": 1.35476,
          "tol_abs": 5e-3
        }
      ]
    },

    {
